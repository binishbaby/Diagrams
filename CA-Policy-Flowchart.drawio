    <!-- ═══════════════════════════════════════════
         SIDE CALLOUT NOTE
    ═══════════════════════════════════════════ -->
    <mxCell id="callout_why" value="&lt;b&gt;💡 Why Three Policies?&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;App1, App2, App3 do not support FIDO authentication.&lt;br/&gt;&lt;br/&gt;Policy 2 excludes them from FIDO enforcement.&lt;br/&gt;&lt;br/&gt;Without Policy 3, Group2 users would access these apps with &lt;b&gt;no MFA at all&lt;/b&gt; — a security gap.&lt;br/&gt;&lt;br/&gt;Policy 3 targets exactly those apps and enforces &lt;b&gt;Microsoft Authenticator&lt;/b&gt; as the fallback MFA method.&lt;br/&gt;&lt;br/&gt;Result: &lt;b&gt;no coverage gap&lt;/b&gt; for any user on any app." style="shape=callout;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=1.5;dashed=1;fontColor=#78350f;fontSize=11;align=left;spacingLeft=8;perimeter=calloutPerimeter;size=20;position=0.5;direction=south;" vertex="1" parent="1">
